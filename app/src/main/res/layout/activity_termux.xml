<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/aetheris_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/aetheris_header"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/aetheris_input_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/aetheris_header"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/aetheris_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❯ INPUT"
                android:textColor="@color/aetheris_cyan"
                android:textStyle="bold"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/aetheris_cwd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="start"
                android:text="~"
                android:textColor="@color/aetheris_cyan"
                android:textSize="12sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/aetheris_branch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:singleLine="true"
                android:textColor="@color/aetheris_violet"
                android:textSize="12sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/aetheris_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="● READY"
                android:textColor="#7FE08A"
                android:textStyle="bold"
                android:textSize="12sp"
                android:typeface="monospace" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textColor="#8A94B8"
                android:textSize="12sp"
                android:typeface="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aetheris_terminal_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/aetheris_input_card"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="4dp"
            android:padding="2dp"
            android:orientation="vertical"
            android:background="@drawable/aetheris_card_bg"
            android:clipToOutline="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="▣ OUTPUT"
                android:textColor="@color/aetheris_violet"
                android:textStyle="bold"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/aetheris_copy_output"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Copy Output"
                android:textColor="@color/aetheris_cyan"
                android:textSize="12sp"
                android:typeface="monospace"
                android:background="@drawable/aetheris_button_bg" />
        </RelativeLayout>

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_settings"
                        android:background="@null"
                        android:contentDescription="@string/action_open_settings"
                        app:tint="?attr/termuxActivityDrawerImageTint" />
                </LinearLayout>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggle_keyboard_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <TextView
            android:id="@+id/aetheris_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:singleLine="true"
            android:text="— chưa có lệnh nào"
            android:textColor="#8A94B8"
            android:textStyle="bold"
            android:textSize="12sp"
            android:typeface="monospace" />

        </LinearLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/aetheris_toolbar_bg"
            android:clipToOutline="true"
            android:layout_above="@+id/aetheris_footer" />

        <RelativeLayout
            android:id="@+id/aetheris_footer"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:paddingHorizontal="12dp"
            android:layout_alignParentBottom="true">

            <TextView
                android:id="@+id/aetheris_footer_left"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:text="@string/aetheris_footer_left"
                android:textColor="@color/aetheris_violet"
                android:textSize="12sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/aetheris_footer_right"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:text="@string/aetheris_footer_right"
                android:textColor="@color/aetheris_cyan"
                android:textSize="12sp"
                android:textStyle="italic"
                android:typeface="monospace" />
        </RelativeLayout>

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
